# Copy this file to ".env" and fill in your own values. Never commit ".env".

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Option A: local PostgreSQL ---
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/levelup_life

# --- Option B: Supabase (Project Settings > Database > Connection string > URI) ---
# DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
